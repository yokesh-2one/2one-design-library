{
  "name": "@yokesh-2one/design-library",
  "version": "0.1.0",
  "type": "module",
  "description": "2one Design Language System — shadcn/ui components re-skinned to the 2one tokens (grayscale, light + audited dark, pill buttons, Satoshi + Inter).",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --config vite.config.dev.ts",
    "build:site": "vite build --config vite.config.dev.ts",
    "build": "vite build && tsc --emitDeclarationOnly -p tsconfig.json && tsc-alias -p tsconfig.json && node scripts/copy-styles.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "a11y": "node scripts/apca-audit.mjs && node scripts/audit-graph-colors.mjs",
    "a11y:graph": "node scripts/audit-graph-colors.mjs",
    "tokens": "node scripts/build-tokens.mjs",
    "manifest": "node scripts/build-manifest.mjs",
    "validate": "node scripts/validate.mjs && node scripts/check-claims.mjs",
    "check:claims": "node scripts/check-claims.mjs",
    "check:exports": "node scripts/check-exports.mjs",
    "check:meta": "npm run build:meta && git diff --exit-code -- tokens manifest.json graph.json",
    "build:meta": "npm run tokens && npm run manifest && npm run graph && npm run validate",
    "verify": "npm run typecheck && npm run check:exports && npm run check:claims && npm run validate && npm run a11y && npm run check:meta && npm run build",
    "graph": "node scripts/build-graph.mjs",
    "what-uses": "node scripts/what-uses.mjs",
    "build:library": "node scripts/build-2one-library.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@storybook/react-vite": "^8.6.18",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-table": "^9.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "date-fns": "^4.4.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "storybook": "^8.6.18",
    "tailwindcss": "^4.3.3",
    "tsc-alias": "^1.9.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^5.7.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react-day-picker": "^10.0.1",
    "react-hook-form": "^7.85.0",
    "react-is": "^19.2.8",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  }
}
