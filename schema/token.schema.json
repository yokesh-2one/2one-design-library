{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/yokesh-2one/2one-design-library/schema/token.schema.json",
  "title": "2one DLS token document",
  "description": "Schema for the canonical machine-readable token files in tokens/*.json (generated by `npm run tokens`). A token document holds one or more of: colour ramps + semantic + contrast, a type scale, or a spacing/radius scale.",
  "type": "object",
  "properties": {
    "description": { "type": "string" },
    "ramps": {
      "type": "object",
      "description": "Named colour ramps (neutral, accent, danger, success), each a map of step → hex.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
      }
    },
    "semantic": {
      "type": "object",
      "description": "Semantic colour tokens (primary, background, border, destructive, …) as resolved hex.",
      "additionalProperties": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
    },
    "contrast": {
      "type": "object",
      "required": ["pairs"],
      "properties": {
        "standard": { "type": "string" },
        "pairs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "text", "background", "wcag_ratio", "apca_lc", "apca_min", "passes"],
            "properties": {
              "name": { "type": "string" },
              "text": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
              "background": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
              "usage": { "type": "string" },
              "wcag_ratio": { "type": "number" },
              "apca_lc": { "type": "number" },
              "apca_min": { "type": "number" },
              "passes": { "type": "boolean" }
            }
          }
        }
      }
    },
    "fonts": {
      "type": "object",
      "properties": { "heading": { "type": "string" }, "body": { "type": "string" } }
    },
    "weights": { "type": "object" },
    "scale": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["size_px"],
        "properties": {
          "size_rem": { "type": "number" },
          "size_px": { "type": "number" },
          "line_height_px": { "type": ["number", "null"] },
          "font": { "type": "string", "enum": ["heading", "body"] }
        }
      }
    },
    "spacing": { "type": "object" },
    "radius": { "type": "object" },
    "shadow": { "type": "object" },
    "rules": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
